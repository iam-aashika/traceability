# Application Configuration
APP_ENV=development
APP_PORT=8000
DATABASE_URL=sqlite:///./ct200_system.db
GENERATIONS_STORAGE_DIR=./storage/generations

# LLM Configuration
# Options: mock, gemini, groq
LLM_PROVIDER=mock
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_MODEL=gemini-1.5-flash
MAX_RETRIES=3
REQUEST_TIMEOUT=30

# OCR Configuration
TESSERACT_CMD=
